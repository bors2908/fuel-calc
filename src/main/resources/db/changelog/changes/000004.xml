<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="1" author="fuel-calc">
        <createTable tableName="archive_state">
            <column name="id" type="smallint">
                <constraints nullable="false" primaryKey="true" primaryKeyName="archive_state_pk"/>
            </column>
            <column name="revision" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <insert tableName="archive_state">
            <column name="id" valueNumeric="1"/>
            <column name="revision" valueNumeric="1"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
    </changeSet>

    <changeSet id="2" author="fuel-calc">
        <insert tableName="fuel_types">
            <column name="code" value="DIESEL"/>
            <column name="name" value="Дизельное топливо"/>
            <column name="sort_order" valueNumeric="0"/>
        </insert>
        <insert tableName="fuel_types">
            <column name="code" value="AI_92"/>
            <column name="name" value="АИ-92"/>
            <column name="sort_order" valueNumeric="1"/>
        </insert>
        <insert tableName="fuel_types">
            <column name="code" value="AI_95"/>
            <column name="name" value="АИ-95"/>
            <column name="sort_order" valueNumeric="2"/>
        </insert>
        <insert tableName="data_sources">
            <column name="code" value="ROSSTAT"/>
            <column name="name" value="Росстат"/>
            <column name="url" value="https://rosstat.gov.ru/statistics/price"/>
        </insert>
        <insert tableName="data_sources">
            <column name="code" value="RUSTATA"/>
            <column name="name" value="rustata"/>
            <column name="url" value="https://rustata.ru/api"/>
        </insert>
        <insert tableName="data_sources">
            <column name="code" value="WHEREFUEL"/>
            <column name="name" value="ГдеТопливо"/>
            <column name="url" value="https://wherefuel.ru/for-business"/>
        </insert>
    </changeSet>

</databaseChangeLog>
