# Copy to .env and set a local database password. Do not commit .env.
POSTGRES_DB=fuel_calc
POSTGRES_USER=fuel_calc
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
SERVER_PORT=8080
FRONTEND_PORT=8081

# Optional external source credentials. Never pass these as Docker build arguments.
RUSTATA_TOKEN=
BENZUP_TOKEN=

# Import controls. BenzUp uses its free regional endpoint; a token is optional.
IMPORTS_ENABLED=true
FETCH_ON_STARTUP=true
ROSSTAT_ENABLED=true
ROSSTAT_FETCH_ON_STARTUP=true
RUSTATA_ENABLED=true
RUSTATA_FETCH_ON_STARTUP=true
BENZUP_ENABLED=true
BENZUP_FETCH_ON_STARTUP=true
BENZUP_CRON=0 15 0,6,12,18 * * *
