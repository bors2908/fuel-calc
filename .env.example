# Copy to .env and set a local database password. Do not commit .env.
POSTGRES_DB=fuel_calc
POSTGRES_USER=fuel_calc
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
SERVER_PORT=8080
FRONTEND_PORT=8081

# Optional external source credentials. Never pass these as Docker build arguments.
RUSTATA_TOKEN=
BENZUP_TOKEN=

# Schedule uses Europe/Moscow. Startup refreshes regions, resumes official history and fetches today's market prices.
IMPORTS_ENABLED=true
FETCH_ON_STARTUP=true
IMPORTS_TIME_ZONE=Europe/Moscow
ROSSTAT_START_DATE=2026-01-01
RUSTATA_START_DATE=2026-01-01
BENZUP_START_DATE=2026-01-01
# TEST DATA GENERATOR ONLY. Never enable in production.
# After a successful BenzUp fetch: weekly official price + per-region/fuel delta + random +/-0.10 RUB.
# Fills days from BENZUP_START_DATE before the earliest market record; existing records stay intact.
# Missing official weeks are skipped. Default: disabled.
BENZUP_TEST_BACKFILL_ENABLED=false
ROSSTAT_CRON=0 0 0 * * *
BENZUP_CRON=0 0 12 * * *
REGION_CATALOG_CRON=0 0 3 * * MON

OKATO_ENDPOINT=https://showdata.rosstat.gov.ru/backbone/set/13032
REGION_SELECTION_ENDPOINT=https://showdata.rosstat.gov.ru/backbone/set/304297
