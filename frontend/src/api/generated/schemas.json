{
  "definitions": {
    "SortOrder": {
      "type": "string",
      "enum": [
        "ASC",
        "DESC"
      ]
    },
    "DataVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "DecimalString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 64
    },
    "NullableDecimalString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 64,
      "nullable": true
    },
    "NullableSignedDecimalString": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 66,
      "nullable": true
    },
    "Money": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
    },
    "SignedMoney": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
    },
    "NullablePercent": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
      "nullable": true
    },
    "VolumeLiters": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,6})(\\.[0-9]{1,2})?$",
      "maxLength": 10
    },
    "ApiMeta": {
      "required": [
        "requestId",
        "generatedAt",
        "serverDate",
        "dataVersion"
      ],
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "serverDate": {
          "type": "string",
          "format": "date"
        },
        "dataVersion": {
          "$ref": "#/definitions/DataVersion"
        }
      }
    },
    "RegionCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[A-Z0-9][A-Z0-9_-]*$"
    },
    "FuelType": {
      "type": "string",
      "enum": [
        "DIESEL",
        "AI_92",
        "AI_95"
      ]
    },
    "RegionRef": {
      "required": [
        "okatoCode",
        "name"
      ],
      "type": "object",
      "properties": {
        "okatoCode": {
          "$ref": "#/definitions/RegionCode"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "FuelTypeRef": {
      "required": [
        "code",
        "name"
      ],
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/definitions/FuelType"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "RegionList": {
      "required": [
        "meta",
        "data"
      ],
      "type": "object",
      "properties": {
        "meta": {
          "$ref": "#/definitions/ApiMeta"
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RegionRef"
          }
        }
      }
    },
    "FuelTypeList": {
      "required": [
        "meta",
        "data"
      ],
      "type": "object",
      "properties": {
        "meta": {
          "$ref": "#/definitions/ApiMeta"
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FuelTypeRef"
          }
        }
      }
    },
    "PriceSource": {
      "type": "string",
      "enum": [
        "OFFICIAL",
        "MARKET"
      ]
    },
    "SourceRef": {
      "required": [
        "code",
        "name",
        "url"
      ],
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "nullable": true
        }
      }
    },
    "SourceUpdate": {
      "required": [
        "source",
        "frequency",
        "status",
        "lastSuccessAt"
      ],
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/definitions/PriceSource"
        },
        "frequency": {
          "$ref": "#/definitions/Frequency"
        },
        "status": {
          "type": "string",
          "enum": [
            "READY",
            "UNAVAILABLE",
            "UNKNOWN"
          ]
        },
        "lastSuccessAt": {
          "type": "string",
          "format": "date-time",
          "nullable": true
        }
      }
    },
    "SourceUpdates": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/SourceUpdate"
      }
    },
    "Frequency": {
      "type": "string",
      "enum": [
        "DAILY",
        "WEEKLY"
      ]
    },
    "ComparisonSortBy": {
      "type": "string",
      "enum": [
        "PRICE",
        "REGION_NAME"
      ]
    },
    "PricePeriod": {
      "required": [
        "key",
        "frequency",
        "referenceDate"
      ],
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "frequency": {
          "$ref": "#/definitions/Frequency"
        },
        "referenceDate": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "MissingPriceReason": {
      "type": "string",
      "enum": [
        "NO_DATA_IN_RANGE",
        "NO_OBSERVATION_FOR_PERIOD"
      ]
    },
    "AvailablePriceCell": {
      "required": [
        "priceRubPerLiter",
        "observationId",
        "period",
        "source",
        "missingReason"
      ],
      "type": "object",
      "properties": {
        "priceRubPerLiter": {
          "$ref": "#/definitions/DecimalString"
        },
        "observationId": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "$ref": "#/definitions/PricePeriod"
        },
        "source": {
          "$ref": "#/definitions/PriceSource"
        },
        "missingReason": {
          "type": "string",
          "nullable": true,
          "enum": [
            null
          ]
        }
      },
      "additionalProperties": false
    },
    "MissingPriceCell": {
      "required": [
        "priceRubPerLiter",
        "observationId",
        "missingReason"
      ],
      "type": "object",
      "properties": {
        "priceRubPerLiter": {
          "type": "string",
          "nullable": true,
          "enum": [
            null
          ]
        },
        "observationId": {
          "type": "string",
          "nullable": true,
          "enum": [
            null
          ]
        },
        "period": {
          "$ref": "#/definitions/PricePeriod"
        },
        "missingReason": {
          "$ref": "#/definitions/MissingPriceReason"
        }
      },
      "additionalProperties": false
    },
    "PriceCell": {
      "oneOf": [
        {
          "$ref": "#/definitions/AvailablePriceCell"
        },
        {
          "$ref": "#/definitions/MissingPriceCell"
        }
      ]
    },
    "PriceChange": {
      "required": [
        "status",
        "startPrice",
        "absoluteRubPerLiter",
        "percent"
      ],
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "AVAILABLE",
            "INSUFFICIENT_DATA",
            "ZERO_BASE"
          ]
        },
        "startPrice": {
          "$ref": "#/definitions/PriceCell"
        },
        "absoluteRubPerLiter": {
          "$ref": "#/definitions/NullableSignedDecimalString"
        },
        "percent": {
          "$ref": "#/definitions/NullablePercent"
        }
      },
      "additionalProperties": false
    },
    "ComparisonStatus": {
      "type": "string",
      "enum": [
        "AVAILABLE",
        "SINGLE_REGION",
        "NO_COMMON_PERIOD",
        "NO_DATA"
      ]
    },
    "ComparisonSummary": {
      "required": [
        "status",
        "lowestPriceRubPerLiter",
        "lowestRegions",
        "hasNewerObservations"
      ],
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/definitions/ComparisonStatus"
        },
        "period": {
          "$ref": "#/definitions/PricePeriod"
        },
        "lowestPriceRubPerLiter": {
          "$ref": "#/definitions/NullableDecimalString"
        },
        "lowestRegions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RegionRef"
          },
          "maxItems": 4
        },
        "hasNewerObservations": {
          "type": "boolean"
        }
      }
    },
    "PriceOverview": {
      "required": [
        "latestPrice",
        "latestAvailableDate",
        "change",
        "comparison"
      ],
      "type": "object",
      "properties": {
        "latestPrice": {
          "$ref": "#/definitions/PriceCell"
        },
        "latestAvailableDate": {
          "type": "string",
          "format": "date",
          "nullable": true
        },
        "change": {
          "$ref": "#/definitions/PriceChange"
        },
        "comparison": {
          "$ref": "#/definitions/ComparisonSummary"
        }
      }
    },
    "RegionPriceSeries": {
      "required": [
        "region",
        "status",
        "points"
      ],
      "type": "object",
      "properties": {
        "region": {
          "$ref": "#/definitions/RegionRef"
        },
        "status": {
          "type": "string",
          "enum": [
            "AVAILABLE",
            "PARTIAL",
            "NO_DATA"
          ]
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TrendPoint"
          }
        }
      }
    },
    "ComparisonRow": {
      "required": [
        "region",
        "isBase",
        "price",
        "latestAvailableDate",
        "differenceRubPerLiter",
        "isLowest"
      ],
      "type": "object",
      "properties": {
        "region": {
          "$ref": "#/definitions/RegionRef"
        },
        "isBase": {
          "type": "boolean"
        },
        "price": {
          "$ref": "#/definitions/PriceCell"
        },
        "latestAvailableDate": {
          "type": "string",
          "format": "date",
          "nullable": true
        },
        "differenceRubPerLiter": {
          "$ref": "#/definitions/NullableSignedDecimalString"
        },
        "isLowest": {
          "type": "boolean"
        }
      }
    },
    "ComparisonInfo": {
      "required": [
        "status",
        "sortBy",
        "sortOrder",
        "allPricesEqual",
        "hasNewerObservations"
      ],
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/definitions/ComparisonStatus"
        },
        "period": {
          "$ref": "#/definitions/PricePeriod"
        },
        "sortBy": {
          "$ref": "#/definitions/ComparisonSortBy"
        },
        "sortOrder": {
          "$ref": "#/definitions/SortOrder"
        },
        "allPricesEqual": {
          "type": "boolean",
          "nullable": true
        },
        "hasNewerObservations": {
          "type": "boolean"
        }
      }
    },
    "Comparison": {
      "allOf": [
        {
          "$ref": "#/definitions/ComparisonInfo"
        },
        {
          "type": "object",
          "required": [
            "data"
          ],
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ComparisonRow"
              },
              "minItems": 1,
              "maxItems": 4
            }
          }
        }
      ]
    },
    "PriceObservation": {
      "required": [
        "region",
        "fuelType",
        "price",
        "latestAvailableDate",
        "provider",
        "publicationDate",
        "loadedAt"
      ],
      "type": "object",
      "properties": {
        "region": {
          "$ref": "#/definitions/RegionRef"
        },
        "fuelType": {
          "$ref": "#/definitions/FuelTypeRef"
        },
        "price": {
          "$ref": "#/definitions/AvailablePriceCell"
        },
        "latestAvailableDate": {
          "type": "string",
          "format": "date",
          "nullable": true
        },
        "publicationDate": {
          "type": "string",
          "format": "date",
          "nullable": true
        },
        "loadedAt": {
          "type": "string",
          "format": "date-time"
        },
        "provider": {
          "$ref": "#/definitions/SourceRef"
        }
      },
      "additionalProperties": false
    },
    "PriceObservationResponse": {
      "required": [
        "meta",
        "observation",
        "sourceUpdates"
      ],
      "type": "object",
      "properties": {
        "meta": {
          "$ref": "#/definitions/ApiMeta"
        },
        "observation": {
          "$ref": "#/definitions/PriceObservation"
        },
        "sourceUpdates": {
          "$ref": "#/definitions/SourceUpdates"
        }
      }
    },
    "RefuelingSelection": {
      "required": [
        "baseRegionCode",
        "regionCodes",
        "fuelType",
        "date"
      ],
      "type": "object",
      "properties": {
        "baseRegionCode": {
          "$ref": "#/definitions/RegionCode"
        },
        "regionCodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/RegionCode"
          }
        },
        "fuelType": {
          "$ref": "#/definitions/FuelType"
        },
        "date": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    },
    "RefuelingCalculateRequest": {
      "required": [
        "selection",
        "volumeLiters"
      ],
      "type": "object",
      "properties": {
        "selection": {
          "$ref": "#/definitions/RefuelingSelection"
        },
        "volumeLiters": {
          "$ref": "#/definitions/VolumeLiters"
        }
      },
      "additionalProperties": false
    },
    "RefuelingRow": {
      "required": [
        "region",
        "price",
        "totalRub",
        "differenceRub",
        "relation"
      ],
      "type": "object",
      "properties": {
        "region": {
          "$ref": "#/definitions/RegionRef"
        },
        "price": {
          "$ref": "#/definitions/AvailablePriceCell"
        },
        "totalRub": {
          "$ref": "#/definitions/Money"
        },
        "differenceRub": {
          "$ref": "#/definitions/SignedMoney"
        },
        "relation": {
          "type": "string",
          "enum": [
            "BASE",
            "LOWER",
            "HIGHER",
            "EQUAL"
          ]
        }
      },
      "additionalProperties": false
    },
    "RefuelingComparison": {
      "allOf": [
        {
          "$ref": "#/definitions/ComparisonInfo"
        },
        {
          "type": "object",
          "required": [
            "data"
          ],
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/RefuelingRow"
              },
              "minItems": 1,
              "maxItems": 4
            }
          }
        }
      ]
    },
    "RefuelingSourceCalculation": {
      "required": [
        "status",
        "baseTotalRub",
        "comparison",
        "source",
        "frequency"
      ],
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/definitions/ComparisonStatus"
        },
        "baseTotalRub": {
          "type": "string",
          "nullable": true,
          "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
        },
        "comparison": {
          "type": "object",
          "nullable": true,
          "oneOf": [
            {
              "$ref": "#/definitions/RefuelingComparison"
            },
            {
              "type": "object",
              "nullable": true,
              "enum": [
                null
              ]
            }
          ]
        },
        "source": {
          "$ref": "#/definitions/PriceSource"
        },
        "frequency": {
          "$ref": "#/definitions/Frequency"
        }
      },
      "additionalProperties": false
    },
    "RefuelingCalculation": {
      "required": [
        "meta",
        "volumeLiters",
        "currency",
        "results",
        "sourceUpdates",
        "context"
      ],
      "type": "object",
      "properties": {
        "meta": {
          "$ref": "#/definitions/ApiMeta"
        },
        "volumeLiters": {
          "$ref": "#/definitions/VolumeLiters"
        },
        "currency": {
          "type": "string",
          "enum": [
            "RUB"
          ]
        },
        "results": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/definitions/RefuelingSourceCalculation"
          }
        },
        "sourceUpdates": {
          "$ref": "#/definitions/SourceUpdates"
        },
        "context": {
          "$ref": "#/definitions/PricePageContext"
        }
      },
      "additionalProperties": false
    },
    "ErrorDetail": {
      "required": [
        "field",
        "code",
        "message"
      ],
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "nullable": true
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ErrorResponse": {
      "required": [
        "type",
        "message",
        "timestamp",
        "requestId",
        "details"
      ],
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "InvalidInput",
            "ResourceNotFound",
            "InternalError",
            "ServiceUnavailable"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ErrorDetail"
          }
        }
      }
    },
    "TrendPoint": {
      "type": "object",
      "required": [
        "date",
        "priceRubPerLiter",
        "observationId",
        "missingReason"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "priceRubPerLiter": {
          "$ref": "#/definitions/NullableDecimalString"
        },
        "observationId": {
          "type": "string",
          "nullable": true
        },
        "missingReason": {
          "type": "string",
          "nullable": true,
          "enum": [
            "NO_DATA_IN_RANGE",
            "NO_OBSERVATION_FOR_PERIOD",
            null
          ]
        }
      }
    },
    "PricePageContext": {
      "required": [
        "baseRegion",
        "regions",
        "fuelType",
        "dateFrom",
        "dateTo"
      ],
      "type": "object",
      "properties": {
        "baseRegion": {
          "$ref": "#/definitions/RegionRef"
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RegionRef"
          },
          "minItems": 1,
          "maxItems": 4
        },
        "fuelType": {
          "$ref": "#/definitions/FuelTypeRef"
        },
        "dateFrom": {
          "type": "string",
          "format": "date"
        },
        "dateTo": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "PriceSourcePage": {
      "type": "object",
      "required": [
        "frequency",
        "overview",
        "trend",
        "comparison"
      ],
      "properties": {
        "frequency": {
          "$ref": "#/definitions/Frequency"
        },
        "overview": {
          "$ref": "#/definitions/PriceOverview"
        },
        "trend": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RegionPriceSeries"
          }
        },
        "comparison": {
          "$ref": "#/definitions/Comparison"
        }
      }
    },
    "PricePage": {
      "type": "object",
      "required": [
        "meta",
        "context",
        "sources",
        "sourceUpdates",
        "comparisonOrder"
      ],
      "properties": {
        "meta": {
          "$ref": "#/definitions/ApiMeta"
        },
        "context": {
          "$ref": "#/definitions/PricePageContext"
        },
        "sources": {
          "type": "object",
          "required": [
            "OFFICIAL",
            "MARKET"
          ],
          "properties": {
            "OFFICIAL": {
              "$ref": "#/definitions/PriceSourcePage"
            },
            "MARKET": {
              "$ref": "#/definitions/PriceSourcePage"
            }
          }
        },
        "sourceUpdates": {
          "$ref": "#/definitions/SourceUpdates"
        },
        "comparisonOrder": {
          "$ref": "#/definitions/PriceSource"
        }
      }
    }
  }
}
