{
  "name": "fuel-calc-tooling",
  "private": true,
  "engines": {
    "node": ">=24.8.0"
  },
  "scripts": {
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,css,html}\" \"*.json\" \".prettierrc.json\" \".htmlvalidate.json\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,css,html}\" \"*.json\" \".prettierrc.json\" \".htmlvalidate.json\"",
    "lint:ts": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input --max-warnings 0",
    "lint:html": "html-validate \"**/*.html\"",
    "lint": "npm run lint:ts && npm run lint:css && npm run lint:html",
    "typecheck": "node scripts/typecheck.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "html-validate": "11.17.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
